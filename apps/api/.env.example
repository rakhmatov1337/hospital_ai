# Copy to apps/api/.env and fill in. NEVER commit the real .env.
NODE_ENV=development
PORT=3000

# Postgres 16 (+ pgvector for the SP3 AI layer). Prisma migrate creates the DB.
DATABASE_URL=postgresql://postgres:password@localhost:5432/hospital_ai

# Hosting region — env var, never a source literal (stop condition #8).
DATA_REGION=UZ
API_BASE_URL=http://localhost:3000

# Production gate. ALLOW_PLACEHOLDER_CONTENT MUST be false in production.
ALLOW_PLACEHOLDER_CONTENT=true
PATIENT_ENROLMENT_ENABLED=false

# RS256 JWT keys. Provide EITHER inline PEMs (newlines escaped as \n) OR file paths.
# Generate a dev pair:
#   node -e "const c=require('crypto');const {publicKey,privateKey}=c.generateKeyPairSync('rsa',{modulusLength:2048,publicKeyEncoding:{type:'spki',format:'pem'},privateKeyEncoding:{type:'pkcs8',format:'pem'}});require('fs').writeFileSync('keys/jwt-private.pem',privateKey);require('fs').writeFileSync('keys/jwt-public.pem',publicKey);"
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY_PATH=keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt-public.pem
