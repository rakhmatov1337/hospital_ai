{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "description": "Hospital AI backend — NestJS + Prisma domain API (SP1 foundation).",
  "scripts": {
    "prebuild": "pnpm --filter @hospital-ai/shared-types build && prisma generate",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "seed": "ts-node -P tsconfig.json src/seed/seed.ts",
    "qa:gate": "ts-node --transpile-only -P tsconfig.json src/ai/qa/run-gate.ts",
    "test": "jest --passWithNoTests && jest --config test/jest-e2e.json --runInBand --passWithNoTests",
    "test:unit": "jest --passWithNoTests",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "echo \"(lint configured in a later task)\"",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "studio": "mastra dev"
  },
  "dependencies": {
    "@hospital-ai/shared-types": "workspace:*",
    "@mastra/core": "^1.52.1",
    "@mastra/loggers": "^1.2.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/client": "^6.3.0",
    "ai": "^7.0.37",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.5.0",
    "nestjs-cls": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuidv7": "^1.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "mastra": "^1.20.1",
    "prisma": "^6.3.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
