# Neon Postgres (pooled connection string). Enable pgvector once: CREATE EXTENSION IF NOT EXISTS vector;
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Auth
JWT_SECRET=change-me

# AI providers (OpenAI required for embeddings + primary model; others enable fallback)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

PORT=3000

# Telegram bot (optional — run separately via `npm run bot`)
# TELEGRAM_BOT_TOKEN from @BotFather; MINI_APP_URL = https URL of the mini app to open
TELEGRAM_BOT_TOKEN=
MINI_APP_URL=https://hospital-ai-patients.vercel.app
