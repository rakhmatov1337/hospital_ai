{
  "info": {
    "name": "Hospital AI (v2 — 4-role)",
    "description": "AI post-surgical recovery platform. Run top-to-bottom (Collection Runner) for the full 4-role golden flow: superadmin -> hospital admin -> doctor -> patient, including AI care-plan generation, AI risk on check-in, streaming nurse chat, and AI eval metrics. Tokens/ids auto-captured.\n\nSeed first: `npm run build && npm run seed && npm run ingest`.\nDemo logins: super@hospital.ai/super123, hospital@hospital.ai/hospital123, demo@hospital.ai/demo123, patient access code HOSP-1235 (Bobur, appendectomy).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1" },
    { "key": "superToken", "value": "" },
    { "key": "hospitalToken", "value": "" },
    { "key": "doctorToken", "value": "" },
    { "key": "patientToken", "value": "" },
    { "key": "surgeryTypeId", "value": "" },
    { "key": "patientId", "value": "" },
    { "key": "accessCode", "value": "" },
    { "key": "carePlanId", "value": "" },
    { "key": "alertId", "value": "" }
  ],
  "item": [
    {
      "name": "Superadmin",
      "item": [
        {
          "name": "01 Login (superadmin)",
          "event": [{ "listen": "test", "script": { "exec": [
            "const j = pm.response.json();",
            "if (j.accessToken) pm.collectionVariables.set('superToken', j.accessToken);",
            "pm.test('super token', () => pm.expect(j.accessToken).to.be.ok);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"super@hospital.ai\",\n  \"password\": \"super123\"\n}" }
          }
        },
        {
          "name": "02 List hospitals",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{superToken}}" }],
            "url": { "raw": "{{baseUrl}}/hospitals", "host": ["{{baseUrl}}"], "path": ["hospitals"] }
          }
        },
        {
          "name": "03 AI metrics (eval scores + confidence)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{superToken}}" }],
            "url": { "raw": "{{baseUrl}}/ai/metrics", "host": ["{{baseUrl}}"], "path": ["ai", "metrics"] }
          }
        },
        {
          "name": "04 AI interactions (audit log)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{superToken}}" }],
            "url": { "raw": "{{baseUrl}}/ai/interactions", "host": ["{{baseUrl}}"], "path": ["ai", "interactions"] }
          }
        },
        {
          "name": "05 KB documents (uploaded training docs)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{superToken}}" }],
            "url": { "raw": "{{baseUrl}}/kb/documents", "host": ["{{baseUrl}}"], "path": ["kb", "documents"] }
          }
        },
        {
          "name": "06 Upload KB document (PDF/markdown -> RAG)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{superToken}}" }],
            "url": { "raw": "{{baseUrl}}/kb/documents", "host": ["{{baseUrl}}"], "path": ["kb", "documents"] },
            "body": { "mode": "formdata", "formdata": [
              { "key": "file", "type": "file", "src": [] },
              { "key": "surgeryTypeId", "value": "{{surgeryTypeId}}", "type": "text" },
              { "key": "title", "value": "Appendectomy Recovery Guide", "type": "text" },
              { "key": "source", "value": "NHS", "type": "text" }
            ] }
          }
        }
      ]
    },
    {
      "name": "Hospital admin",
      "item": [
        {
          "name": "01 Login (hospital admin)",
          "event": [{ "listen": "test", "script": { "exec": [
            "const j = pm.response.json();",
            "if (j.accessToken) pm.collectionVariables.set('hospitalToken', j.accessToken);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"hospital@hospital.ai\",\n  \"password\": \"hospital123\"\n}" }
          }
        },
        {
          "name": "02 Hospital overview",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{hospitalToken}}" }],
            "url": { "raw": "{{baseUrl}}/hospital/overview", "host": ["{{baseUrl}}"], "path": ["hospital", "overview"] }
          }
        },
        {
          "name": "03 Create doctor",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{hospitalToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/doctors", "host": ["{{baseUrl}}"], "path": ["doctors"] },
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Dr. Sevara Aliyeva\",\n  \"email\": \"sevara@hospital.ai\",\n  \"password\": \"doctor123\",\n  \"title\": \"Surgeon\"\n}" }
          }
        },
        {
          "name": "04 List doctors",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{hospitalToken}}" }],
            "url": { "raw": "{{baseUrl}}/doctors", "host": ["{{baseUrl}}"], "path": ["doctors"] }
          }
        }
      ]
    },
    {
      "name": "Doctor",
      "item": [
        {
          "name": "01 Login (doctor)",
          "event": [{ "listen": "test", "script": { "exec": [
            "const j = pm.response.json();",
            "if (j.accessToken) pm.collectionVariables.set('doctorToken', j.accessToken);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"demo@hospital.ai\",\n  \"password\": \"demo123\"\n}" }
          }
        },
        {
          "name": "02 Surgery types (capture appendectomy id)",
          "event": [{ "listen": "test", "script": { "exec": [
            "const a = pm.response.json();",
            "const c = a.find(t => (t.name || '').includes('Appendectomy')) || a[0];",
            "if (c) pm.collectionVariables.set('surgeryTypeId', c.id);"
          ] } }],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/surgery-types", "host": ["{{baseUrl}}"], "path": ["surgery-types"] }
          }
        },
        {
          "name": "03 Dashboard (stats + recent patients)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{doctorToken}}" }],
            "url": { "raw": "{{baseUrl}}/doctor/dashboard", "host": ["{{baseUrl}}"], "path": ["doctor", "dashboard"] }
          }
        },
        {
          "name": "04 Create patient -> AI care plan (DRAFT)",
          "event": [{ "listen": "test", "script": { "exec": [
            "const j = pm.response.json();",
            "if (j.patient) pm.collectionVariables.set('patientId', j.patient.id);",
            "if (j.accessCode) pm.collectionVariables.set('accessCode', j.accessCode);",
            "if (j.carePlan) pm.collectionVariables.set('carePlanId', j.carePlan.carePlanId);",
            "pm.test('access code + AI plan', () => pm.expect(j.accessCode).to.be.ok);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/patients", "host": ["{{baseUrl}}"], "path": ["patients"] },
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Jasur Karimov\",\n  \"email\": \"jasur@mail.ru\",\n  \"phone\": \"+998901230000\",\n  \"age\": 28,\n  \"surgeryTypeId\": \"{{surgeryTypeId}}\",\n  \"surgeryDate\": \"2026-06-03\"\n}" }
          }
        },
        {
          "name": "05 Approve care plan (DRAFT -> ACTIVE)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{doctorToken}}" }],
            "url": { "raw": "{{baseUrl}}/care-plan/{{carePlanId}}/approve", "host": ["{{baseUrl}}"], "path": ["care-plan", "{{carePlanId}}", "approve"] }
          }
        },
        {
          "name": "06 Patient care plan (grouped)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{doctorToken}}" }],
            "url": { "raw": "{{baseUrl}}/patients/{{patientId}}/care-plan", "host": ["{{baseUrl}}"], "path": ["patients", "{{patientId}}", "care-plan"] }
          }
        },
        {
          "name": "07 Analytics (recovery chart + AI advisor)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{doctorToken}}" }],
            "url": { "raw": "{{baseUrl}}/doctor/analytics", "host": ["{{baseUrl}}"], "path": ["doctor", "analytics"] }
          }
        }
      ]
    },
    {
      "name": "Patient",
      "item": [
        {
          "name": "01 Login (access code)",
          "event": [{ "listen": "test", "script": { "exec": [
            "const j = pm.response.json();",
            "if (j.accessToken) pm.collectionVariables.set('patientToken', j.accessToken);",
            "pm.test('patient token', () => pm.expect(j.accessToken).to.be.ok);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/patient-login", "host": ["{{baseUrl}}"], "path": ["auth", "patient-login"] },
            "body": { "mode": "raw", "raw": "{\n  \"accessCode\": \"HOSP-1235\"\n}" }
          }
        },
        {
          "name": "02 Dashboard",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": { "raw": "{{baseUrl}}/me/dashboard", "host": ["{{baseUrl}}"], "path": ["me", "dashboard"] }
          }
        },
        {
          "name": "03 Checklist",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": { "raw": "{{baseUrl}}/me/checklist", "host": ["{{baseUrl}}"], "path": ["me", "checklist"] }
          }
        },
        {
          "name": "04 Medications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": { "raw": "{{baseUrl}}/me/medications", "host": ["{{baseUrl}}"], "path": ["me", "medications"] }
          }
        },
        {
          "name": "05 Diet",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": { "raw": "{{baseUrl}}/me/diet", "host": ["{{baseUrl}}"], "path": ["me", "diet"] }
          }
        },
        {
          "name": "06 Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": { "raw": "{{baseUrl}}/me/profile", "host": ["{{baseUrl}}"], "path": ["me", "profile"] }
          }
        },
        {
          "name": "07 Daily check-in -> AI risk + auto alert",
          "event": [{ "listen": "test", "script": { "exec": [
            "const j = pm.response.json();",
            "pm.test('risk scored', () => pm.expect(j.risk).to.be.ok);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/me/check-in", "host": ["{{baseUrl}}"], "path": ["me", "check-in"] },
            "body": { "mode": "raw", "raw": "{\n  \"painLevel\": 9,\n  \"temperature\": 38.9,\n  \"symptoms\": [\"heavy bleeding\", \"pus\"],\n  \"mood\": \"anxious\"\n}" }
          }
        },
        {
          "name": "08 Nurse chat (SSE token stream)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/me/chat", "host": ["{{baseUrl}}"], "path": ["me", "chat"] },
            "body": { "mode": "raw", "raw": "{\n  \"messages\": [{ \"role\": \"user\", \"content\": \"Can I take a bath on day 4 after my appendix surgery?\" }]\n}" }
          }
        }
      ]
    },
    {
      "name": "Doctor — alerts (after patient check-in)",
      "item": [
        {
          "name": "01 List alerts (unread first)",
          "event": [{ "listen": "test", "script": { "exec": [
            "const a = pm.response.json();",
            "if (a[0]) pm.collectionVariables.set('alertId', a[0].id);"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{doctorToken}}" }],
            "url": { "raw": "{{baseUrl}}/alerts", "host": ["{{baseUrl}}"], "path": ["alerts"] }
          }
        },
        {
          "name": "02 Mark alert read",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{doctorToken}}" }],
            "url": { "raw": "{{baseUrl}}/alerts/{{alertId}}/read", "host": ["{{baseUrl}}"], "path": ["alerts", "{{alertId}}", "read"] }
          }
        }
      ]
    }
  ]
}
